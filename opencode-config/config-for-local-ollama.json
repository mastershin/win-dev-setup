{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/gpt-oss:20b",
  "small_model": "ollama/nemotron-3-nano:30b",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (Local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "nemotron-3-nano:30b": {
          "name": "Nemotron 3 Nano",
          "tools": true
        },
        "gpt-oss:20b": {
          "name": "GPT-OSS 20B",
          "tools": true
        },
        "qwen3-coder:30b": {
          "name": "Qwen 3 Coder 30B",
          "tools": true
        },
        "qwen3-vl": {
          "name": "Qwen 3 Vision-Language",
          "tools": true
        },
        "deepseek-r1:32b": {
          "name": "DeepSeek R1 32B (Reasoning)",
          "tools": true
        }
      }
    }
  }
}